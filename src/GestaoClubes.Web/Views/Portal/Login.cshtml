@model GestaoClubes.Core.LoginRequest
<section class="narrow"><h1>Entrar no clube</h1><p>Acesse suas atividades e acompanhe suas solicitações.</p><div asp-validation-summary="All"></div><form method="post"><label asp-for="Email">E-mail</label><input asp-for="Email" type="email" required autocomplete="username"/><label asp-for="Password">Senha</label><input asp-for="Password" type="password" required autocomplete="current-password"/><button>Entrar</button></form></section>
