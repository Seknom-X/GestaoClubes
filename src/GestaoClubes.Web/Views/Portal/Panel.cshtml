@model GestaoClubes.Web.Models.Panel
@using System.Text.Json
@using GestaoClubes.Core
<h1>Clube @Model.ClubId</h1><nav class="tabs">@foreach(var tab in new[]{("events","Eventos"),("reservations","Reservas"),("finance","Mensalidades"),("tickets","Atendimentos"),("dependents","Dependentes"),("profile","Meus dados")}){<a href="?clubId=@Model.ClubId&module=@tab.Item1">@tab.Item2</a>}@if(Model.Admin){@foreach(var tab in new[]{("club","Configuração"),("members","Aprovações"),("audit","Auditoria")}){<a href="?clubId=@Model.ClubId&module=@tab.Item1">@tab.Item2</a>}}</nav>
@if(Model.Module=="club") {<section><h2>Configuração do clube</h2><pre>@JsonSerializer.Serialize(Model.Data,new JsonSerializerOptions{WriteIndented=true})</pre><form asp-action="Club" method="post"><input type="hidden" name="clubId" value="@Model.ClubId"/><partial name="_ClubFields" model="Model.Data"/><button>Salvar configuração</button></form></section>}
else if(Model.Module=="profile"){<section><h2>Meus dados</h2><p>Somente você pode consultar estes dados. Para correção ou exclusão, abra uma solicitação.</p><pre>@JsonSerializer.Serialize(Model.Data,new JsonSerializerOptions{WriteIndented=true})</pre></section>}
else if(Model.Module=="finance"){
 <section><h2>Mensalidades e saldos</h2><p>Total lançado: @Model.Data.GetProperty("total") · Recebido: @Model.Data.GetProperty("received") · Em aberto: @Model.Data.GetProperty("outstanding") · Vencido: @Model.Data.GetProperty("overdue")</p><table><tr><th>Associado</th><th>Competência</th><th>Vencimento</th><th>Valor</th><th>Pagamento</th></tr>@foreach(var r in Model.Data.GetProperty("charges").EnumerateArray()){<tr><td>@r.GetProperty("name") (vínculo @r.GetProperty("membershipId"))</td><td>@r.GetProperty("period")</td><td>@r.GetProperty("dueDate")</td><td>@r.GetProperty("amount")</td><td>@r.GetProperty("paidUtc") @if(Model.Treasury&&r.GetProperty("paidUtc").ValueKind==JsonValueKind.Null){<form asp-action="Payment" method="post"><input type="hidden" name="clubId" value="@Model.ClubId"/><input type="hidden" name="id" value="@r.GetProperty("id")"/><label>Referência da baixa manual<input name="Reference" required maxlength="200"/></label><button>Registrar pagamento</button></form>}</td></tr>}</table></section>
 @if(Model.Treasury){<section><h3>Lançar mensalidade</h3><form asp-action="Charge" method="post"><input type="hidden" name="clubId" value="@Model.ClubId"/><label>Associado aprovado<select name="MembershipId">@foreach(var m in Model.Data.GetProperty("eligibleMembers").EnumerateArray()){<option value="@m.GetProperty("id")">@m.GetProperty("name") (vínculo @m.GetProperty("id"))</option>}</select></label><label>Competência<input name="Period" type="month" required/></label><label>Vencimento<input name="DueDate" type="date" required/></label><button>Lançar valor configurado no clube</button></form></section>}
}
else {
 @foreach(var row in Model.Data.EnumerateArray()) {<section>
  <dl>@foreach(var prop in row.EnumerateObject()){<dt><strong>@prop.Name</strong></dt><dd>@prop.Value</dd>}</dl>
  @if(Model.Module=="members"&&Model.Admin){<form asp-action="Approve" method="post"><input type="hidden" name="clubId" value="@Model.ClubId"/><input type="hidden" name="id" value="@row.GetProperty("id")"/><label>Situação<select name="Status">@foreach(var s in Enum.GetNames<Approval>()){<option selected="@(row.GetProperty("status").GetString()==s)">@s</option>}</select></label><label>Perfil<select name="Role">@foreach(var s in Enum.GetNames<Role>().Where(x=>Model.SuperAdmin||x!="Presidente")){<option selected="@(row.GetProperty("role").GetString()==s)">@s</option>}</select></label><label>Tipo de associado<select name="Type">@foreach(var s in Enum.GetNames<MemberType>()){<option selected="@(row.GetProperty("type").GetString()==s)">@s</option>}</select></label><button>Salvar aprovação e perfil</button></form>}
  @if(Model.Module=="reservations"){<form asp-action="ReservationStatus" method="post"><input type="hidden" name="clubId" value="@Model.ClubId"/><input type="hidden" name="id" value="@row.GetProperty("id")"/><label>Decisão<select name="Status">@if(Model.Admin){<option>Aprovada</option><option>Rejeitada</option>}<option>Cancelada</option></select></label><button>Atualizar reserva</button></form>}
  @if(Model.Module=="tickets"&&Model.Admin){<form asp-action="Reply" method="post"><input type="hidden" name="clubId" value="@Model.ClubId"/><input type="hidden" name="id" value="@row.GetProperty("id")"/><label>Situação<select name="Status">@foreach(var s in Enum.GetNames<TicketStatus>()){<option>@s</option>}</select></label><label>Resposta<textarea name="Response" required maxlength="2000"></textarea></label><button>Responder</button></form>}
  @if(Model.Module=="dependents"){<form asp-action="DeleteDependent" method="post"><input type="hidden" name="clubId" value="@Model.ClubId"/><input type="hidden" name="id" value="@row.GetProperty("id")"/><button>Excluir dependente</button></form>}
  @if(Model.Module=="events"&&Model.Admin){<details><summary>Editar ou cancelar evento</summary><form asp-action="Event" method="post"><input type="hidden" name="clubId" value="@Model.ClubId"/><input type="hidden" name="id" value="@row.GetProperty("id")"/><label>Título<input name="Title" value="@row.GetProperty("title")" required/></label><label>Início UTC<input name="StartUtc" type="datetime-local" value="@row.GetProperty("startUtc").GetDateTime().ToString("yyyy-MM-ddTHH:mm")" required/></label><label>Fim UTC<input name="EndUtc" type="datetime-local" value="@row.GetProperty("endUtc").GetDateTime().ToString("yyyy-MM-ddTHH:mm")" required/></label><label>Público<select name="Public"><option value="true" selected="@row.GetProperty("public").GetBoolean()">Aberto</option><option value="false" selected="@(!row.GetProperty("public").GetBoolean())">Associados</option></select></label><label>Situação<select name="Cancelled"><option value="false">Ativo</option><option value="true" selected="@row.GetProperty("cancelled").GetBoolean()">Cancelado</option></select></label><button>Salvar evento</button></form></details>}
 </section>}
 @if(Model.Module=="events"&&Model.Admin){<section><h3>Novo evento</h3><form asp-action="Event" method="post"><input type="hidden" name="clubId" value="@Model.ClubId"/><label>Título<input name="Title" required maxlength="160"/></label><label>Início UTC<input name="StartUtc" type="datetime-local" required/></label><label>Fim UTC<input name="EndUtc" type="datetime-local" required/></label><label>Público<select name="Public"><option value="true">Aberto</option><option value="false">Associados</option></select></label><button>Criar evento</button></form></section>}
 @if(Model.Module=="reservations"){<section><h3>Solicitar reserva</h3><p>Horários em UTC (Brasília + 3 horas). Reservas pendentes bloqueiam o intervalo.</p><form asp-action="Reserve" method="post"><input type="hidden" name="clubId" value="@Model.ClubId"/><label>Espaço<select name="Space"><option>SALAO SOCIAL</option><option>CHURRASQUEIRA</option></select></label><label>Finalidade<input name="Purpose" required maxlength="160"/></label><label>Início UTC<input name="StartUtc" type="datetime-local" required/></label><label>Fim UTC<input name="EndUtc" type="datetime-local" required/></label><button>Solicitar aprovação</button></form></section>}
 @if(Model.Module=="dependents"){<section><h3>Novo dependente</h3><p>Cadastre somente dependentes sob sua responsabilidade e com informação ao responsável legal.</p><form asp-action="Dependent" method="post"><input type="hidden" name="clubId" value="@Model.ClubId"/><label>Nome<input name="Name" required maxlength="120"/></label><label>Nascimento<input name="BirthDate" type="date" required/></label><label>Parentesco<input name="Relationship" required maxlength="40"/></label><button>Cadastrar</button></form></section>}
 @if(Model.Module=="tickets"){<section><h3>Abrir atendimento</h3><form asp-action="Ticket" method="post"><input type="hidden" name="clubId" value="@Model.ClubId"/><label>Tipo<select name="Kind"><option>Solicitacao</option><option>Reclamacao</option></select></label><label>Mensagem<textarea name="Text" required maxlength="2000"></textarea></label><button>Enviar</button></form></section>}
}
